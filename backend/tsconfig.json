{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  // Tests are excluded from the build so they never ship; they are still
  // type-checked via tsconfig.test.json (the `typecheck` script).
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/test"]
}
