# Loaded from the repo root by backend/src/config/env.ts (not backend/.env).

# Required - the process refuses to start without these four
DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=change-me
# 64 hex chars (openssl rand -hex 32). Encrypts Orderful/Workato credentials.
# Deliberately independent of JWT_SECRET so rotating one does not break the other.
WK_ENCRYPTION_KEY=
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Optional
PORT=3100
NODE_ENV=development
PORTAL_URL=http://localhost:5174
DB_POOL_SIZE=10
JWT_EXPIRY=12h
BCRYPT_ROUNDS=12
# Reconcile tenant consumers against tenant status this often
CONSUMER_SYNC_INTERVAL_MS=30000
# Body limit for ingest (Workato job logs run ~80KB for a small PO)
INGEST_BODY_LIMIT=5mb
# Orderful raw-EDI conversion (per-tenant switch lives on the tenant: raw_edi_enabled)
ORDERFUL_API_URL=https://api.orderful.com
RAW_EDI_ENABLED=true
RAW_EDI_INTERVAL_MS=60000
RAW_EDI_PER_TENANT_BATCH=25
RAW_EDI_CONCURRENCY=3
# Folder ingestion: drop Workato job-log .json files into <dir>/<tenant slug>/ (on by default outside production)
# INGEST_DROP_ENABLED=true
# INGEST_DROP_DIR=
# INGEST_DROP_INTERVAL_MS=5000
